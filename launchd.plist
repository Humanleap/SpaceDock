<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>@ID@</string>
	<key>ProgramArguments</key>
	<array>
		<string>@HOME@/Applications/SpaceDock.app/Contents/MacOS/SpaceDock</string>
	</array>
	<key>RunAtLoad</key>
	<true/>
	<key>LimitLoadToSessionType</key>
	<string>Aqua</string>
	<key>StandardOutPath</key>
	<string>@HOME@/Library/Logs/SpaceDock.log</string>
	<key>StandardErrorPath</key>
	<string>@HOME@/Library/Logs/SpaceDock.log</string>
</dict>
</plist>
